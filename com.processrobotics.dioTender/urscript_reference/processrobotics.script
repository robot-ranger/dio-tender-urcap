  # begin: URCap Installation Node
  #   Source: DIO-Tender, 1.0.0.SNAPSHOT, Process Robotics
  #   Type: DIO Tender
  # ---- DIO Tender: Modbus signal map (Installation > DIO Tender) ----
  SIG_M21 = "m21"
  SIG_MFIN = "mfin"
  SIG_VISE1 = "vise1"
  SIG_VISE2 = "vise2"
  SIG_DOOR = "openDoor"
  SIG_DOOR_OPENED = "doorOpened"
  SIG_DOOR_CLOSED = "doorClosed"
  G1 = 0 # tool digital out, HIGH = gripper closed
  G2 = 1
  VISE_TIME = 1.0
  MFIN_PULSE = 0.5
  DOOR_TIMEOUT = 10.0
  global tend_req = "idle" # "idle" = idle, "unload" = m21 latched, "load" = unload done
  def set_req():
  global tend_req = "unload"
  end
  def fail(msg):
  popup(msg, "Machine tending", error = True, blocking = True)
  halt
  end
  def mb_on(sig):
  return modbus_get_signal_status(sig, False) > 0
  end
  def mb_set(sig, on):
  if (on):
    modbus_set_output_register(sig, 1, False)
  else:
    modbus_set_output_register(sig, 0, False)
  end
  end
  def wait_mb(sig, timeout):
  t = 0
  while (not(mb_on(sig))):
    if (t > timeout):
      fail(str_cat("Timeout waiting for ", sig))
    end
    t = t + get_steptime()
    sync()
  end
  end
  thread m21_watch():
    last = False
    while (True):
      now = mb_on(SIG_M21)
      if (now and not last):
        set_req()
        textmsg("m21 latched")
      end
      last = now
      sync()
    end
  end
  def vise(sig, open):
  mb_set(sig, open)
  sleep(VISE_TIME)
  end
  def door(open):
  mb_set(SIG_DOOR, open)
  if (open):
    wait_mb(SIG_DOOR_OPENED, DOOR_TIMEOUT)
  else:
    wait_mb(SIG_DOOR_CLOSED, DOOR_TIMEOUT)
  end
  end
  def release_machine():
    door(False)
    mb_set(SIG_MFIN, True)
    sleep(MFIN_PULSE)
    mb_set(SIG_MFIN, False)
  end
  m21_watch_thrd = run m21_watch()
  # end: URCap Installation Node
  # begin: URCap Installation Node
  #   Source: Stack Light, 1.0.0.SNAPSHOT, Process Robotics
  #   Type: Stack Light
  # Stack Light URCap (Advantech WISE-S100)
  stacklight_rpc = rpc_factory("xmlrpc", "http://127.0.0.1:40470/RPC2")
  stacklight_rpc.configure("/dev/ttyUSB0", 9600, 1)
  def _stacklight_mask(color):
    if color == "red":
      return 3
    elif color == "yellow":
      return 24
    elif color == "green":
      return 192
    end
    return 0
  end
  def _stacklight_check(color, condition):
    sl_mask = _stacklight_mask(color)
    if sl_mask == 0:
      return -1
    end
    return stacklight_rpc.match_mask(sl_mask, condition)
  end
  def stacklight_get_state(color):
    sl_mask = _stacklight_mask(color)
    if sl_mask == 0:
      return -1
    end
    return stacklight_rpc.get_mask_state(sl_mask)
  end
  def stacklight_segment_state(segment):
    return stacklight_rpc.get_state(segment)
  end
  def stacklight_is_on(color):
    return _stacklight_check(color, 1) == 1
  end
  def stacklight_is_off(color):
    return _stacklight_check(color, 0) == 1
  end
  def stacklight_is_blinking(color):
    return _stacklight_check(color, 4) == 1
  end
  def stacklight_is_lit(color):
    return _stacklight_check(color, 5) == 1
  end
  def stacklight_connected():
    return stacklight_rpc.is_connected()
  end
  def stacklight_wait(color, condition, timeout, description):
    sl_elapsed = 0.0
    sl_result = _stacklight_check(color, condition)
    while sl_result != 1:
      if sl_result == -1:
        popup("This color is not assigned to a stack light segment. Check Installation > URCaps > Stack Light.", title=description, error=True, blocking=True)
        halt
      elif sl_result == -2:
        popup("Stack light sensor is not responding. Check the RS-485 cable, sensor power and the serial port in Installation > URCaps > Stack Light.", title=description, error=True, blocking=True)
        halt
      elif sl_result == -3:
        popup("The stack light sensor reports a fault on every segment of this color (disabled, not present or broken).", title=description, error=True, blocking=True)
        halt
      end
      if timeout > 0 and sl_elapsed >= timeout:
        popup("Timed out waiting for the stack light.", title=description, error=True, blocking=True)
        halt
      end
      sleep(0.1)
      sl_elapsed = sl_elapsed + 0.1
      sl_result = _stacklight_check(color, condition)
    end
  end
  # end: URCap Installation Node
  # begin: URCap Installation Node
